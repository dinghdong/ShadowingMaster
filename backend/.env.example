# ===== ShadowingMaster 后端环境变量示例 =====
# 复制为 .env 后填写；docker run 用 --env-file .env 注入。
# 全部 OSS_* 留空 → 自动降级为本地磁盘（开发/兜底模式）。

# 鉴权密钥（生产务必替换为长随机串）
SECRET_KEY=change-me-to-a-long-random-string

# 允许跨域的前端域名（逗号分隔）；Vercel 部署时填你的前端域名
CORS_ALLOW_ORIGINS=https://shadowingmaster.vercel.app

# ── 阿里云 OSS（媒体存储，伦敦海外桶免备案）──
# 桶保持「私有」即可：后端对每条媒体生成「带签名的临时 URL」给前端，
# 无需把桶设为公共读，更安全。OSS_URL_EXPIRE 为签名 URL 有效期（秒）。
OSS_ENDPOINT=oss-eu-west-1.aliyuncs.com
OSS_BUCKET=your-bucket-name
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_REGION=eu-west-1
OSS_URL_EXPIRE=3600

# ── YouTube 下载反爬（可选）──
# 伦敦服务器 IP 易触发 YouTube "confirm you're not a bot"，需登录态 cookie。
# 在已登录 YouTube 的浏览器中导出 cookies.txt（Netscape 格式）放到本文件同目录，
# 再把路径填到这里；留空则不使用 cookie（可能被反爬拦截）。
YTDLP_COOKIES_FILE=

# 住宅代理（residential proxy）：伦敦数据中心 IP 会被 YouTube 主动吊销会话 cookie，
# 必须把 yt-dlp 流量导到「住宅/ISP」IP 才能被接受。留空则直连（数据中心 IP 会被挡）。
# 格式：http://user:pass@host:port  或  socks5://user:pass@host:port
# 注意：必须是住宅/ISP 代理；普通数据中心代理同样会被 YouTube 拦截。
# 仅 yt-dlp 的 YouTube 流量走这里，API/OSS 上传仍走服务器本机直连。
YTDLP_PROXY=
