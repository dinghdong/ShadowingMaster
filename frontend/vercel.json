{
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "installCommand": "rm -rf node_modules && npm install",
  "buildCommand": "npm run build",
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/app",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/wordbook",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/profile",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/add",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/login",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/video/:id",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
